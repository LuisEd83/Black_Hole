━ ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
→ CUDA:
    
    • Real time
        ◦ 10 segundos por frame é inviável para real time. O caminho para chegar a 30+ fps tem três etapas:
        ◦ Etapa 1 — reduzir trabalho por pixel. O gargalo atual é que raios na fotosfera fazem milhares de steps. Com o passo adaptativo bem calibrado e um early exit agressivo para raios que claramente escapam, você pode chegar a ~500ms por frame.
        ◦ Etapa 2 — resolução adaptativa. Renderiza em 480×270 (16x menos pixels) para movimentação de câmera e resolução completa só quando a câmera para. Isso é o que o cam.moving do kavan fazia com os 200×150 pixels — exatamente essa ideia. Com 16x menos pixels, 500ms vira ~30ms.
        ◦ Etapa 3 — CUDA-GL interop. Atualmente o pipeline é kernel → cudaMemcpy para host → glTexSubImage2D para GPU. Isso copia os pixels duas vezes entre CPU e GPU desnecessariamente. Com cudaGraphicsGLRegisterImage o kernel escreve diretamente na textura OpenGL sem passar pelo host. Para frames pequenos o ganho é modesto, mas para 1080p é significativo.
        ◦ A combinação das três etapas deve chegar a 30fps em resolução baixa e alguns segundos por frame em resolução alta — similar ao comportamento do Interstellar game engine onde você move em baixa res e a imagem "resolve" quando para.



